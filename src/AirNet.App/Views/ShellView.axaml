<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirNet.App.ViewModels"
             xmlns:views="using:AirNet.App.Views"
             xmlns:controls="using:AirNet.App.Controls"
             x:Class="AirNet.App.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="44,46,*,30" Background="{DynamicResource AppBackgroundBrush}">
    <!-- Workspace bar: brand, live link chip, one primary action, window controls. -->
    <Border x:Name="TitleBar"
            Grid.Row="0"
            Background="{DynamicResource TitleBarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,0"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentBrush}">
            <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="{StaticResource IconPulse}"
                      Stroke="White"
                      StrokeThickness="1.8"
                      StrokeLineCap="Round"
                      StrokeJoin="Round" />
                <Ellipse Canvas.Left="18.4"
                         Canvas.Top="9.9"
                         Width="3.2"
                         Height="3.2"
                         Fill="#F2C879" />
              </Canvas>
            </Viewbox>
          </Border>
          <TextBlock Text="AirNet"
                     FontSize="14.5"
                     FontWeight="Bold"
                     LetterSpacing="-0.2"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Margin="14,0,0,0">
          <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="0,0,6,0" />
          <Border Classes="pill" Padding="10,4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ConnectionChip}" FontSize="11.5" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Classes="pill" Padding="9,4">
            <TextBlock Text="{Binding SourceChipText}" Classes="caption" FontSize="10.5" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="soft"
                  Height="30"
                  MinHeight="30"
                  Padding="11,0"
                  Command="{Binding RunScanCommand}"
                  IsVisible="{Binding !IsScanning}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IconZap}"
                    Width="14"
                    Height="14"
                    Stroke="{DynamicResource AccentTextBrush}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Stretch="Uniform"
                    VerticalAlignment="Center" />
              <TextBlock Text="开始检测" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Classes="soft"
                  Height="30"
                  MinHeight="30"
                  Padding="11,0"
                  Command="{Binding StopScanCommand}"
                  IsVisible="{Binding IsScanning}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IconStop}"
                    Width="11"
                    Height="11"
                    Fill="{DynamicResource AccentTextBrush}"
                    Stretch="Uniform"
                    VerticalAlignment="Center" />
              <TextBlock Text="停止" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
          </Button>

          <Button Classes="icon small"
                  Command="{Binding ToggleThemeCommand}"
                  ToolTip.Tip="切换主题">
            <Panel>
              <Path Classes="icon small muted" Data="{StaticResource IconMoon}" IsVisible="{Binding IsDarkMode}" />
              <Path Classes="icon small muted" Data="{StaticResource IconSun}" IsVisible="{Binding !IsDarkMode}" />
            </Panel>
          </Button>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
            <Button Classes="windowControl" Click="OnMinimizeWindowClick" ToolTip.Tip="最小化">
              <Border Width="10" Height="1.2" Background="{DynamicResource TextPrimaryBrush}" />
            </Button>
            <Button Classes="windowControl" Click="OnToggleMaximizeWindowClick" ToolTip.Tip="最大化 / 还原">
              <Panel Width="10" Height="10">
                <Path x:Name="MaximizeGlyph" Classes="windowGlyph" Data="{StaticResource IconWindowMaximize}" />
                <Path x:Name="RestoreGlyph" Classes="windowGlyph" Data="{StaticResource IconWindowRestore}" IsVisible="False" />
              </Panel>
            </Button>
            <Button Classes="windowControl windowClose" Click="OnCloseWindowClick" ToolTip.Tip="关闭">
              <Path Classes="windowGlyph" Data="{StaticResource IconClose}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Live status strip -->
    <Border Grid.Row="1"
            Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid RowDefinitions="*,3">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="14,0">
          <StackPanel Orientation="Horizontal"
                      Spacing="10"
                      VerticalAlignment="Center"
                      IsVisible="{Binding !IsScanning}">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding View.Verdict}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" />
            <TextBlock Text="{Binding LastScanText}" Classes="caption" VerticalAlignment="Center" />
            <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" />
            <TextBlock Text="{Binding View.SampleCountText}" Classes="micro" VerticalAlignment="Center" />
            <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" />
            <TextBlock Text="{Binding View.PeakText}" Classes="micro" VerticalAlignment="Center" />
          </StackPanel>

          <!-- While scanning the strip tells you what it is doing, not what it last found. -->
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsScanning}">
            <Ellipse Classes="scanDot" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ScanStatusText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentTextBrush}"
                       VerticalAlignment="Center" />
            <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" />
            <TextBlock Text="{Binding ScanElapsedText}" Classes="mono" FontSize="10.5" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="自动刷新" Classes="caption" VerticalAlignment="Center" />
            <ToggleButton Classes="switch"
                          IsChecked="{Binding Settings.AutoRefresh, Mode=TwoWay}"
                          ToolTip.Tip="每 60 秒自动检测一次；窗口最小化时暂停"
                          VerticalAlignment="Center" />
            <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="6,0" />
            <Button Classes="ghost"
                    Height="28"
                    MinHeight="28"
                    Padding="10,0"
                    FontSize="11.5"
                    Click="OnExportReportClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon small muted" Data="{StaticResource IconReport}" />
                <TextBlock Text="导出报告" FontSize="11.5" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="1"
                     Minimum="0"
                     Maximum="1"
                     Value="{Binding ScanFraction}"
                     Height="3"
                     MinHeight="3"
                     Margin="0"
                     Padding="0"
                     CornerRadius="0"
                     Background="Transparent"
                     IsVisible="{Binding IsScanning}" />
      </Grid>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="2" ColumnDefinitions="216,*">
      <Border Grid.Column="0"
              Background="{DynamicResource SidebarBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Margin="14,16,14,8" Spacing="10">
            <TextBlock Text="WORKSPACE" Classes="eyebrow" Margin="4,0,0,0" />
            <StackPanel Spacing="3">
              <Button Classes="nav" Classes.active="{Binding IsOverviewSelected}" Command="{Binding NavigateCommand}" CommandParameter="Overview">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Classes="navIcon" Data="{StaticResource IconLayers}" />
                  <TextBlock Classes="navLabel" Text="总览" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsMonitorSelected}" Command="{Binding NavigateCommand}" CommandParameter="Monitor">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Classes="navIcon" Data="{StaticResource IconActivity}" />
                  <TextBlock Classes="navLabel" Text="实时检测" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsSpeedSelected}" Command="{Binding NavigateCommand}" CommandParameter="Speed">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Classes="navIcon" Data="{StaticResource IconGauge}" />
                  <TextBlock Classes="navLabel" Text="带宽测速" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsSitesSelected}" Command="{Binding NavigateCommand}" CommandParameter="Sites">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Classes="navIcon" Data="{StaticResource IconGlobe}" />
                  <TextBlock Classes="navLabel" Text="网站延迟" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsPathSelected}" Command="{Binding NavigateCommand}" CommandParameter="Path">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Classes="navIcon" Data="{StaticResource IconTarget}" />
                  <TextBlock Classes="navLabel" Text="链路路径" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsHistorySelected}" Command="{Binding NavigateCommand}" CommandParameter="History">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Classes="navIcon" Data="{StaticResource IconHistory}" />
                  <TextBlock Classes="navLabel" Text="历史趋势" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsSettingsSelected}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Classes="navIcon" Data="{StaticResource IconSliders}" />
                  <TextBlock Classes="navLabel" Text="设置" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="18,14,18,0" Spacing="10" VerticalAlignment="Top">
            <Border Classes="hairline" Margin="0,0,0,4" />
            <TextBlock Text="本机链路" Classes="eyebrow" />
            <StackPanel Spacing="7">
              <Grid ColumnDefinitions="52,*">
                <TextBlock Text="局域网" Classes="micro" />
                <TextBlock Grid.Column="1" Text="{Binding View.LocalAddress}" Classes="mono" FontSize="10.5" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid ColumnDefinitions="52,*">
                <TextBlock Text="网关" Classes="micro" />
                <TextBlock Grid.Column="1" Text="{Binding View.GatewayAddress}" Classes="mono" FontSize="10.5" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid ColumnDefinitions="52,*">
                <TextBlock Text="DNS" Classes="micro" />
                <TextBlock Grid.Column="1" Text="{Binding View.DnsServer}" Classes="mono" FontSize="10.5" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid ColumnDefinitions="52,*">
                <TextBlock Text="出口" Classes="micro" />
                <TextBlock Grid.Column="1" Text="{Binding View.EgressText}" Classes="mono" FontSize="10.5" TextTrimming="CharacterEllipsis" />
              </Grid>
            </StackPanel>
          </StackPanel>

          <Border Grid.Row="2" Margin="12,0,12,12" Classes="card" Padding="12,10">
            <StackPanel Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon small accent" Data="{StaticResource IconShield}" Width="13" Height="13" />
                <TextBlock Text="轻量模式" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Text="无常驻 · 无驱动 · 仅在检测时联网"
                         Classes="micro"
                         FontSize="10"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Panel x:Name="PageHost" Grid.Column="1">
        <Border Classes="pageHost" IsVisible="{Binding IsOverviewSelected}" Classes.scanning="{Binding IsScanning}">
          <views:OverviewView DataContext="{Binding Overview}" />
        </Border>
        <Border Classes="pageHost" IsVisible="{Binding IsMonitorSelected}">
          <views:MonitorView DataContext="{Binding Monitor}" />
        </Border>
        <Border Classes="pageHost" IsVisible="{Binding IsSpeedSelected}">
          <views:SpeedView DataContext="{Binding Speed}" />
        </Border>
        <Border Classes="pageHost" IsVisible="{Binding IsSitesSelected}">
          <views:SiteLatencyView DataContext="{Binding SiteLatency}" />
        </Border>
        <Border Classes="pageHost" IsVisible="{Binding IsPathSelected}">
          <views:PathView DataContext="{Binding Path}" />
        </Border>
        <Border Classes="pageHost" IsVisible="{Binding IsHistorySelected}">
          <views:HistoryView DataContext="{Binding Trends}" />
        </Border>
        <Border Classes="pageHost" IsVisible="{Binding IsSettingsSelected}">
          <views:SettingsView DataContext="{Binding Settings}" />
        </Border>
      </Panel>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3"
            Background="{DynamicResource StatusBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusMessage}" Classes="caption" FontSize="11" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding FooterLatencyText}" Classes="caption" FontSize="11" />
          <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}" />
          <TextBlock Text="{Binding FooterLossText}" Classes="caption" FontSize="11" />
          <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}" />
          <TextBlock Text="{Binding FooterTimestampText}" Classes="caption tertiary" FontSize="11" />
          <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}" />
          <TextBlock Text="AIRNET 0.2.7" Classes="micro" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Site manager overlay: spans the whole window so the dimming matches the design. -->
    <Grid Grid.RowSpan="4" Panel.ZIndex="20" IsVisible="{Binding SiteLatency.IsManagerOpen}">
      <views:SiteManagerView DataContext="{Binding SiteLatency}" />
    </Grid>
  </Grid>
</UserControl>
