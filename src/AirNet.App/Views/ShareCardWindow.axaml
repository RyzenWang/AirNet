<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:AirNet.App.Views"
        xmlns:vm="using:AirNet.App.ViewModels"
        x:Class="AirNet.App.Views.ShareCardWindow"
        x:DataType="vm:ShareCardViewModel"
        Title="AirNet 分享卡片"
        Width="760"
        Height="920"
        MinWidth="640"
        MinHeight="760"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="18" RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" PointerPressed="OnTitleBarPointerPressed">
      <StackPanel Spacing="1">
        <TextBlock Text="分享卡片" Classes="h3" />
        <TextBlock Text="生成一张适合发群或社交平台的 PNG" Classes="caption" FontSize="10.5" />
      </StackPanel>
      <Button Grid.Column="1"
              Classes="icon small"
              Click="OnCloseClick"
              ToolTip.Tip="关闭">
        <Path Classes="icon small muted" Data="{StaticResource IconClose}" />
      </Button>
    </Grid>

    <Border Grid.Row="1"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10"
            ClipToBounds="True">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
          <views:ShareCardView DataContext="{Binding}" />
        </Viewbox>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock x:Name="Status"
                 Classes="micro"
                 FontSize="10"
                 VerticalAlignment="Center"
                 Text="PNG · 1080 × 1350" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost" Height="32" MinHeight="32" Padding="12,0" Content="关闭" Click="OnCloseClick" />
        <Button Classes="primary" Height="32" MinHeight="32" Padding="14,0" Content="保存 PNG" Click="OnSaveClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
