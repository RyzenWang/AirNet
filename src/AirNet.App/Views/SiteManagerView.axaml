<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirNet.App.ViewModels"
             x:Class="AirNet.App.Views.SiteManagerView"
             x:DataType="vm:SiteLatencyViewModel">
  <UserControl.Styles>
    <Style Selector="Border.pickBadge">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pickBadge.intl">
      <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
    </Style>
    <Style Selector="TextBlock.pickBadgeText">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.pickBadgeText.intl">
      <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.groupTitle">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="Margin" Value="0,9,0,4" />
    </Style>
  </UserControl.Styles>

  <Grid Background="#66000000">
    <Border Width="900"
            Height="660"
            Classes="card floating"
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <Grid RowDefinitions="64,*,54">
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,0">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{DynamicResource L.ManageSites}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource L.SitesManagerNote}" FontSize="10"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="icon small" Width="28" Height="28"
                    Command="{Binding CloseManagerCommand}" Content="×" FontSize="18"
                    ToolTip.Tip="关闭" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,316">
          <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="18,10,18,12">
            <StackPanel>
              <TextBlock Text="{DynamicResource L.Domestic7}" Classes="groupTitle" />
              <ItemsControl ItemsSource="{Binding DefaultDomestic}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SitePickRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" Height="30">
                      <Border Classes="pickBadge" Classes.intl="{Binding IsInternational}">
                        <TextBlock Text="{Binding Badge}" Classes="pickBadgeText"
                                   Classes.intl="{Binding IsInternational}" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Host}" FontSize="7.5" FontFamily="{DynamicResource MonoFontFamily}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{DynamicResource L.Fixed}" FontSize="8"
                                 Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{DynamicResource L.International4}" Classes="groupTitle" />
              <ItemsControl ItemsSource="{Binding DefaultInternational}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SitePickRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" Height="30">
                      <Border Classes="pickBadge" Classes.intl="{Binding IsInternational}">
                        <TextBlock Text="{Binding Badge}" Classes="pickBadgeText"
                                   Classes.intl="{Binding IsInternational}" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Host}" FontSize="7.5" FontFamily="{DynamicResource MonoFontFamily}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{DynamicResource L.Fixed}" FontSize="8"
                                 Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,4">
                <TextBlock Text="{DynamicResource L.CustomSites}" Classes="groupTitle" Margin="0" />
                <TextBlock Grid.Column="1" Text="{Binding CustomLimitText}" FontSize="8.5"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
              </Grid>

              <ItemsControl ItemsSource="{Binding CustomSiteRows}" IsVisible="{Binding HasCustomSites}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CustomSiteRow">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7" Height="34">
                        <Border Classes="pickBadge">
                          <TextBlock Text="{Binding Badge}" Classes="pickBadgeText" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                          <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Host}" FontSize="7.5" FontFamily="{DynamicResource MonoFontFamily}"
                                     Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="mini" Height="24" MinHeight="24" Padding="7,0"
                                Content="{DynamicResource L.Edit}" FontSize="9" Click="OnEditCustomClick" />
                        <Button Grid.Column="3" Classes="mini" Height="24" MinHeight="24" Padding="7,0"
                                Content="{Binding DeleteLabel}" FontSize="9" Click="OnDeleteCustomClick" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9"
                      Padding="10" IsVisible="{Binding !HasCustomSites}">
                <TextBlock Text="{DynamicResource L.NoCustomSites}"
                           Classes="micro" FontSize="9.5" LineHeight="15" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                  Padding="18,10,18,12">
            <StackPanel Spacing="7">
              <TextBlock Text="{Binding DraftTitle}" FontSize="12.5" FontWeight="SemiBold" />

              <StackPanel Spacing="3">
                <TextBlock Text="{DynamicResource L.Name}" FontSize="9.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Classes="field" Text="{Binding DraftName, Mode=TwoWay}"
                         Watermark="{DynamicResource L.NameExample}" />
              </StackPanel>

              <StackPanel Spacing="3">
                <TextBlock Text="{DynamicResource L.Address}" FontSize="9.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Classes="field" Text="{Binding DraftHost, Mode=TwoWay}"
                         Watermark="https://status.example.com" />
              </StackPanel>

              <StackPanel Spacing="3">
                <TextBlock Text="{DynamicResource L.Group}" FontSize="9.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Height="32" Padding="8,0">
                  <TextBlock Text="{DynamicResource L.CustomFixed}" FontSize="10" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
              </StackPanel>

              <TextBlock Text="{DynamicResource L.HttpsOnly}"
                         Classes="micro" FontSize="9" LineHeight="14" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DraftError}"
                         IsVisible="{Binding HasManagerError}"
                         FontSize="9.5" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DraftTestText}"
                         FontFamily="{DynamicResource MonoFontFamily}"
                         FontSize="8.5"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" />

              <Grid ColumnDefinitions="*,*" ColumnSpacing="7" Margin="0,3,0,0">
                <Button Classes="ghost"
                        Height="30"
                        MinHeight="30"
                        Padding="10,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="{DynamicResource L.TestConnectivity}"
                        Command="{Binding TestDraftCommand}"
                        IsEnabled="{Binding !IsTestingDraft}" />
                <Button Grid.Column="1"
                        Classes="primary"
                        Height="30"
                        MinHeight="30"
                        Padding="10,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="{DynamicResource L.SaveSite}"
                        Command="{Binding SaveDraftCommand}" />
              </Grid>
              <TextBlock Text="{DynamicResource L.SiteRules}"
                         Classes="micro" FontSize="8.5" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource L.SitesManagerFooter}"
                       Classes="micro" FontSize="9" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="soft" Height="28" MinHeight="28" Padding="14,0"
                    Command="{Binding CloseManagerCommand}" Content="{DynamicResource L.Done}" FontSize="10.5" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
