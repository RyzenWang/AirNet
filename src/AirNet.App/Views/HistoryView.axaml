<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirNet.App.ViewModels"
             xmlns:controls="using:AirNet.App.Controls"
             x:Class="AirNet.App.Views.HistoryView"
             x:DataType="vm:TrendsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.summary">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="13,11" />
    </Style>
    <Style Selector="TextBlock.trendValue">
      <Setter Property="FontSize" Value="23" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.6" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="1160" Margin="24,18,24,26" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="1">
          <TextBlock Text="历史趋势" Classes="h3" />
          <TextBlock Text="把每次检测连起来，看延迟、评分和时段规律。"
                     Classes="caption"
                     FontSize="10.5" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Background="{DynamicResource SurfaceAltBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="2">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="seg"
                      Classes.active="{Binding IsSevenDayRange}"
                      Command="{Binding SetRangeCommand}"
                      CommandParameter="7"
                      Content="7 天" />
              <Button Classes="seg"
                      Classes.active="{Binding IsThirtyDayRange}"
                      Command="{Binding SetRangeCommand}"
                      CommandParameter="30"
                      Content="30 天" />
            </StackPanel>
          </Border>
          <Button Classes="ghost"
                  Height="30"
                  MinHeight="30"
                  Padding="10,0"
                  Command="{Binding RefreshCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Path Classes="icon small muted" Data="{StaticResource IconRefresh}" />
              <TextBlock Text="刷新" FontSize="10.5" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Empty state -->
      <Border Grid.Row="1"
              Classes="card"
              IsVisible="{Binding IsEmpty}"
              Padding="28,34"
              MinHeight="260">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <Border Width="42"
                  Height="42"
                  CornerRadius="12"
                  Background="{DynamicResource AccentSoftBrush}"
                  HorizontalAlignment="Center">
            <Path Data="{StaticResource IconHistory}"
                  Width="19"
                  Height="19"
                  Stroke="{DynamicResource AccentTextBrush}"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="还没有历史记录" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="完成一次真实检测后，趋势会从这次开始累积。"
                     Classes="caption"
                     FontSize="10.5"
                     HorizontalAlignment="Center" />
          <Button Classes="soft"
                  Height="30"
                  MinHeight="30"
                  Padding="12,0"
                  Margin="0,8,0,0"
                  Content="开始检测"
                  Command="{Binding Shell.RunScanCommand}" />
        </StackPanel>
      </Border>

      <!-- Trend content -->
      <StackPanel Grid.Row="1" Spacing="12" IsVisible="{Binding HasData}">
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
          <Border Classes="summary">
            <StackPanel Spacing="2">
              <TextBlock Text="平均评分" Classes="eyebrow" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding AverageScoreText}" Classes="trendValue" />
                <TextBlock Text="/ 100" Classes="unit" VerticalAlignment="Bottom" />
              </StackPanel>
              <TextBlock Text="{Binding RunCountText}" Classes="micro" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="summary">
            <StackPanel Spacing="2">
              <TextBlock Text="平均延迟" Classes="eyebrow" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding AverageLatencyText}" Classes="trendValue" />
                <TextBlock Text="ms" Classes="unit" VerticalAlignment="Bottom" />
              </StackPanel>
              <TextBlock Text="每次检测的平均值" Classes="micro" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="summary">
            <StackPanel Spacing="2">
              <TextBlock Text="平均抖动" Classes="eyebrow" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding AverageJitterText}" Classes="trendValue" />
                <TextBlock Text="ms" Classes="unit" VerticalAlignment="Bottom" />
              </StackPanel>
              <TextBlock Text="相邻样本差均值" Classes="micro" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Classes="summary">
            <StackPanel Spacing="2">
              <TextBlock Text="平均丢包" Classes="eyebrow" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding AverageLossText}" Classes="trendValue" />
                <TextBlock Text="%" Classes="unit" VerticalAlignment="Bottom" />
              </StackPanel>
              <TextBlock Text="来自 ICMP 探测" Classes="micro" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="1.35*,1*" ColumnSpacing="12">
          <!-- Latency trend -->
          <Border Classes="card" Padding="16,13">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="延迟趋势" Classes="h3" FontSize="13" />
                <TextBlock Grid.Column="1"
                           Text="{Binding RangeCaption}"
                           Classes="micro"
                           FontSize="10"
                           VerticalAlignment="Center" />
              </Grid>
              <Grid Height="164">
                <controls:Sparkline Series="{Binding LatencySeries}"
                                    Stroke="{DynamicResource GoodBrush}"
                                    Fill="{DynamicResource ChartFillBrush}"
                                    StrokeThickness="2"
                                    GridLines="4"
                                    GridLineBrush="{DynamicResource GridLineBrush}"
                                    ShowEndDot="False"
                                    AnimateReveal="True" />
                <TextBlock Text="{Binding LatencyMaxText}"
                           Classes="mono"
                           FontSize="8.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top" />
                <TextBlock Text="{Binding LatencyMinText}"
                           Classes="mono"
                           FontSize="8.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="按检测时间从左到右" Classes="micro" FontSize="9.5" />
                <TextBlock Grid.Column="1" Text="每次检测的平均延迟" Classes="micro" FontSize="9.5" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Time-of-day buckets -->
          <Border Grid.Column="1" Classes="card" Padding="16,13">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="时段观察" Classes="h3" FontSize="13" />
                <TextBlock Grid.Column="1" Text="本地时间" Classes="micro" FontSize="9.5" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Buckets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrendBucketRow">
                    <Grid ColumnDefinitions="50,*,58" ColumnSpacing="7" Margin="0,3">
                      <StackPanel Spacing="0">
                        <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RangeText}" Classes="micro" FontSize="8.5" />
                      </StackPanel>
                      <controls:MeterBar Grid.Column="1"
                                         Height="5"
                                         Value="{Binding Bar}"
                                         VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2" Spacing="0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding LatencyText}" Classes="mono" FontSize="9.5" TextAlignment="Right" />
                        <TextBlock Text="{Binding CountText}" Classes="micro" FontSize="8.5" TextAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="hairline" />
              <TextBlock Text="{Binding InsightText}"
                         Classes="caption"
                         FontSize="9.5"
                         LineHeight="14"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="1*,1.35*" ColumnSpacing="12">
          <!-- Score trend -->
          <Border Classes="card" Padding="16,13">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="评分趋势" Classes="h3" FontSize="13" />
                <TextBlock Grid.Column="1" Text="{Binding RangeCaption}" Classes="micro" FontSize="10" />
              </Grid>
              <Grid Height="122">
                <controls:Sparkline Series="{Binding ScoreSeries}"
                                    Stroke="{DynamicResource GoodBrush}"
                                    Fill="{DynamicResource ChartFillBrush}"
                                    StrokeThickness="2"
                                    GridLines="4"
                                    GridLineBrush="{DynamicResource GridLineBrush}"
                                    ShowEndDot="False" />
                <TextBlock Text="{Binding ScoreMaxText}"
                           Classes="mono"
                           FontSize="8.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top" />
                <TextBlock Text="{Binding ScoreMinText}"
                           Classes="mono"
                           FontSize="8.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Recent runs -->
          <Border Grid.Column="1" Classes="card" Padding="16,13">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="最近记录" Classes="h3" FontSize="13" />
                <TextBlock Grid.Column="1" Text="最近 8 次" Classes="micro" FontSize="9.5" />
              </Grid>
              <ItemsControl ItemsSource="{Binding RecentRuns}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrendRunRow">
                    <Grid ColumnDefinitions="42,*,42,42" ColumnSpacing="8" Margin="0,2">
                      <StackPanel Spacing="0">
                        <TextBlock Text="{Binding DateText}" Classes="micro" FontSize="8.5" />
                        <TextBlock Text="{Binding TimeText}" Classes="mono" FontSize="9.5" />
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding LatencyText}"
                                 Classes="mono"
                                 FontSize="9.5"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding LossText}"
                                 Classes="micro"
                                 FontSize="9"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center" />
                      <Border Grid.Column="3"
                              Classes="sevBadge"
                              Classes.warn="{Binding IsWarn}"
                              Classes.bad="{Binding IsBad}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScoreText}"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
