<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirNet.App.ViewModels"
             xmlns:controls="using:AirNet.App.Controls"
             x:Class="AirNet.App.Views.HistoryView"
             x:DataType="vm:TrendsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.summary">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="13,11" />
    </Style>
    <Style Selector="TextBlock.trendValue">
      <Setter Property="FontSize" Value="23" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.6" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.compareDelta.better">
      <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
    </Style>
    <Style Selector="TextBlock.compareDelta.worse">
      <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="1160" Margin="24,18,24,26" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="1">
          <TextBlock Text="{DynamicResource L.History}" Classes="h3" />
          <TextBlock Text="{DynamicResource L.HistorySubtitle}"
                     Classes="caption"
                     FontSize="10.5" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Background="{DynamicResource SurfaceAltBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="2">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="seg"
                      Classes.active="{Binding IsSevenDayRange}"
                      Command="{Binding SetRangeCommand}"
                      CommandParameter="7"
                      Content="{DynamicResource L.Days7}" />
              <Button Classes="seg"
                      Classes.active="{Binding IsThirtyDayRange}"
                      Command="{Binding SetRangeCommand}"
                      CommandParameter="30"
                      Content="{DynamicResource L.Days30}" />
            </StackPanel>
          </Border>
          <Button Classes="ghost"
                  Height="30"
                  MinHeight="30"
                  Padding="10,0"
                  Command="{Binding RefreshCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Path Classes="icon small muted" Data="{StaticResource IconRefresh}" />
              <TextBlock Text="{DynamicResource L.Refresh}" FontSize="10.5" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Empty state -->
      <Border Grid.Row="1"
              Classes="card"
              IsVisible="{Binding IsEmpty}"
              Padding="28,34"
              MinHeight="260">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <Border Width="42"
                  Height="42"
                  CornerRadius="12"
                  Background="{DynamicResource AccentSoftBrush}"
                  HorizontalAlignment="Center">
            <Path Data="{StaticResource IconHistory}"
                  Width="19"
                  Height="19"
                  Stroke="{DynamicResource AccentTextBrush}"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{DynamicResource L.NoHistoryTitle}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{DynamicResource L.NoHistoryNote}"
                     Classes="caption"
                     FontSize="10.5"
                     HorizontalAlignment="Center" />
          <Button Classes="soft"
                  Height="30"
                  MinHeight="30"
                  Padding="12,0"
                  Margin="0,8,0,0"
                  Content="{DynamicResource L.StartScan}"
                  Command="{Binding Shell.RunScanCommand}" />
        </StackPanel>
      </Border>

      <!-- Trend content -->
      <StackPanel Grid.Row="1" Spacing="12" IsVisible="{Binding HasData}">
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
          <Border Classes="summary">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource L.AverageScore}" Classes="eyebrow" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding AverageScoreText}" Classes="trendValue" />
                <TextBlock Text="/ 100" Classes="unit" VerticalAlignment="Bottom" />
              </StackPanel>
              <TextBlock Text="{Binding RunCountText}" Classes="micro" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="summary">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource L.AverageLatency}" Classes="eyebrow" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding AverageLatencyText}" Classes="trendValue" />
                <TextBlock Text="ms" Classes="unit" VerticalAlignment="Bottom" />
              </StackPanel>
              <TextBlock Text="{DynamicResource L.PerScanAverage}" Classes="micro" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="summary">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource L.AverageJitter}" Classes="eyebrow" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding AverageJitterText}" Classes="trendValue" />
                <TextBlock Text="ms" Classes="unit" VerticalAlignment="Bottom" />
              </StackPanel>
              <TextBlock Text="{DynamicResource L.JitterDefinition}" Classes="micro" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Classes="summary">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource L.AverageLoss}" Classes="eyebrow" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding AverageLossText}" Classes="trendValue" />
                <TextBlock Text="%" Classes="unit" VerticalAlignment="Bottom" />
              </StackPanel>
              <TextBlock Text="{DynamicResource L.FromIcmp}" Classes="micro" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="1.35*,1*" ColumnSpacing="12">
          <!-- Latency trend -->
          <Border Classes="card" Padding="16,13">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource L.LatencyTrend}" Classes="h3" FontSize="13" />
                <TextBlock Grid.Column="1"
                           Text="{Binding RangeCaption}"
                           Classes="micro"
                           FontSize="10"
                           VerticalAlignment="Center" />
              </Grid>
              <Grid Height="164">
                <controls:Sparkline Series="{Binding LatencySeries}"
                                    Stroke="{DynamicResource GoodBrush}"
                                    Fill="{DynamicResource ChartFillBrush}"
                                    StrokeThickness="2"
                                    GridLines="4"
                                    GridLineBrush="{DynamicResource GridLineBrush}"
                                    ShowEndDot="False"
                                    AnimateReveal="True" />
                <TextBlock Text="{Binding LatencyMaxText}"
                           Classes="mono"
                           FontSize="8.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top" />
                <TextBlock Text="{Binding LatencyMinText}"
                           Classes="mono"
                           FontSize="8.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource L.TimeLeftToRight}" Classes="micro" FontSize="9.5" />
                <TextBlock Grid.Column="1" Text="{DynamicResource L.EachScanLatency}" Classes="micro" FontSize="9.5" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Time-of-day buckets -->
          <Border Grid.Column="1" Classes="card" Padding="16,13">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource L.TimeOfDay}" Classes="h3" FontSize="13" />
                <TextBlock Grid.Column="1" Text="{DynamicResource L.LocalTime}" Classes="micro" FontSize="9.5" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Buckets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrendBucketRow">
                    <Grid ColumnDefinitions="50,*,58" ColumnSpacing="7" Margin="0,3">
                      <StackPanel Spacing="0">
                        <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RangeText}" Classes="micro" FontSize="8.5" />
                      </StackPanel>
                      <controls:MeterBar Grid.Column="1"
                                         Height="5"
                                         Value="{Binding Bar}"
                                         VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2" Spacing="0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding LatencyText}" Classes="mono" FontSize="9.5" TextAlignment="Right" />
                        <TextBlock Text="{Binding CountText}" Classes="micro" FontSize="8.5" TextAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="hairline" />
              <TextBlock Text="{Binding InsightText}"
                         Classes="caption"
                         FontSize="9.5"
                         LineHeight="14"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="1*,1.35*" ColumnSpacing="12">
          <!-- Score trend -->
          <Border Classes="card" Padding="16,13">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource L.ScoreTrend}" Classes="h3" FontSize="13" />
                <TextBlock Grid.Column="1" Text="{Binding RangeCaption}" Classes="micro" FontSize="10" />
              </Grid>
              <Grid Height="122">
                <controls:Sparkline Series="{Binding ScoreSeries}"
                                    Stroke="{DynamicResource GoodBrush}"
                                    Fill="{DynamicResource ChartFillBrush}"
                                    StrokeThickness="2"
                                    GridLines="4"
                                    GridLineBrush="{DynamicResource GridLineBrush}"
                                    ShowEndDot="False" />
                <TextBlock Text="{Binding ScoreMaxText}"
                           Classes="mono"
                           FontSize="8.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top" />
                <TextBlock Text="{Binding ScoreMinText}"
                           Classes="mono"
                           FontSize="8.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Recent runs -->
          <Border Grid.Column="1" Classes="card" Padding="16,13">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource L.RecentRecords}" Classes="h3" FontSize="13" />
                <TextBlock Grid.Column="1" Text="{DynamicResource L.Last8}" Classes="micro" FontSize="9.5" />
              </Grid>
              <ItemsControl ItemsSource="{Binding RecentRuns}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrendRunRow">
                    <Grid ColumnDefinitions="42,*,42,42" ColumnSpacing="8" Margin="0,2">
                      <StackPanel Spacing="0">
                        <TextBlock Text="{Binding DateText}" Classes="micro" FontSize="8.5" />
                        <TextBlock Text="{Binding TimeText}" Classes="mono" FontSize="9.5" />
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding LatencyText}"
                                 Classes="mono"
                                 FontSize="9.5"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding LossText}"
                                 Classes="micro"
                                 FontSize="9"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center" />
                      <Border Grid.Column="3"
                              Classes="sevBadge"
                              Classes.warn="{Binding IsWarn}"
                              Classes.bad="{Binding IsBad}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScoreText}"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <!-- A/B comparison -->
        <Border Classes="card" Padding="16,13">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource L.ABCompare}" Classes="h3" FontSize="13" />
              <TextBlock Grid.Column="1" Text="{DynamicResource L.PickAB}" Classes="micro" FontSize="9.5" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
              <ComboBox ItemsSource="{Binding CompareOptions}"
                        SelectedItem="{Binding CompareA}"
                        MinWidth="190"
                        FontSize="10.5">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryChoice">
                    <TextBlock Text="{Binding Label}" FontSize="10.5" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Column="1" Text="{DynamicResource L.Compare}" Classes="caption" FontSize="10" VerticalAlignment="Center" />
              <ComboBox Grid.Column="2"
                        ItemsSource="{Binding CompareOptions}"
                        SelectedItem="{Binding CompareB}"
                        MinWidth="190"
                        FontSize="10.5">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryChoice">
                    <TextBlock Text="{Binding Label}" FontSize="10.5" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <TextBlock Text="{Binding CompareSummary}"
                       Classes="caption"
                       FontSize="9.5"
                       LineHeight="14"
                       TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource L.CompareEmpty}"
                       Classes="caption"
                       FontSize="10"
                       IsVisible="{Binding ShowCompareEmpty}" />

            <Grid IsVisible="{Binding HasComparison}" RowDefinitions="Auto,Auto" RowSpacing="3">
              <Grid ColumnDefinitions="90,120,120,130" ColumnSpacing="8" HorizontalAlignment="Left">
                <TextBlock Text="{DynamicResource L.Metric}" Classes="eyebrow" FontSize="8.5" />
                <TextBlock Grid.Column="1" Text="A" Classes="eyebrow" FontSize="8.5" />
                <TextBlock Grid.Column="2" Text="B" Classes="eyebrow" FontSize="8.5" />
                <TextBlock Grid.Column="3" Text="{DynamicResource L.Change}" Classes="eyebrow" FontSize="8.5" />
              </Grid>
              <ItemsControl Grid.Row="1" ItemsSource="{Binding CompareRows}" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CompareMetricRow">
                    <Grid ColumnDefinitions="90,120,120,130" ColumnSpacing="8" Margin="0,2">
                      <TextBlock Text="{Binding Name}" FontSize="10" />
                      <TextBlock Grid.Column="1" Text="{Binding AText}" Classes="mono" FontSize="9.5" />
                      <TextBlock Grid.Column="2" Text="{Binding BText}" Classes="mono" FontSize="9.5" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding DeltaText}"
                                 Classes="compareDelta"
                                 Classes.better="{Binding IsBetter}"
                                 Classes.worse="{Binding IsWorse}"
                                 FontSize="9.5"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
