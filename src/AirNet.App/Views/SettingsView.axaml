<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirNet.App.ViewModels"
             x:Class="AirNet.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="1000" Margin="24,18,24,26" RowDefinitions="Auto,*" RowSpacing="12">
      <StackPanel Grid.Row="0" Spacing="1">
        <TextBlock Text="{DynamicResource L.Settings}" Classes="h3" />
        <TextBlock Text="{DynamicResource L.SettingsNote}" Classes="caption" FontSize="10.5" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
        <StackPanel Spacing="12">
          <Border Classes="card" Padding="18,16">
            <StackPanel Spacing="11">
              <TextBlock Text="{DynamicResource L.Theme}" Classes="h3" FontSize="13.5" />
              <TextBlock Text="{DynamicResource L.AppearanceNote}"
                         Classes="caption"
                         FontSize="10.5"
                         LineHeight="16"
                         TextWrapping="Wrap" />
              <Border Background="{DynamicResource SurfaceAltBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="9"
                      Padding="3"
                      HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Classes="seg"
                          Classes.active="{Binding Shell.IsSystemTheme}"
                          Command="{Binding Shell.SetThemeModeCommand}"
                          CommandParameter="System"
                          Content="{DynamicResource L.FollowSystem}" />
                  <Button Classes="seg"
                          Classes.active="{Binding Shell.IsLightTheme}"
                          Command="{Binding Shell.SetThemeModeCommand}"
                          CommandParameter="Light"
                          Content="{DynamicResource L.Light}" />
                  <Button Classes="seg"
                          Classes.active="{Binding Shell.IsDarkTheme}"
                          Command="{Binding Shell.SetThemeModeCommand}"
                          CommandParameter="Dark"
                          Content="{DynamicResource L.Dark}" />
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <TextBlock Text="{DynamicResource L.Language}" Classes="caption" VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="3"
                        HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="seg"
                            Classes.active="{Binding IsChineseLanguage}"
                            Command="{Binding SetLanguageCommand}"
                            CommandParameter="zh-CN"
                            Content="{DynamicResource L.Chinese}" />
                    <Button Classes="seg"
                            Classes.active="{Binding IsEnglishLanguage}"
                            Command="{Binding SetLanguageCommand}"
                            CommandParameter="en"
                            Content="{DynamicResource L.English}" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="18,16">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource L.Testing}" Classes="h3" FontSize="13.5" Margin="0,0,0,8" />

              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <StackPanel Spacing="1">
                  <TextBlock Text="{DynamicResource L.AutoRefreshTitle}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource L.AutoRefreshNote}" Classes="micro" FontSize="10" />
                </StackPanel>
                <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding AutoRefresh, Mode=TwoWay}" VerticalAlignment="Center" />
              </Grid>
              <Border Classes="hairline" />

              <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,10">
                <StackPanel Spacing="1">
                  <TextBlock Text="{DynamicResource L.DualProbeTitle}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource L.DualProbeNote}" Classes="micro" FontSize="10" />
                </StackPanel>
                <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding DualProbe, Mode=TwoWay}" VerticalAlignment="Center" />
              </Grid>
              <Border Classes="hairline" />

              <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                <StackPanel Spacing="1">
                  <TextBlock Text="{DynamicResource L.KeepHistoryTitle}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource L.KeepHistoryNote}" Classes="micro" FontSize="10" />
                </StackPanel>
                <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding KeepHistory, Mode=TwoWay}" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="18,16">
            <StackPanel Spacing="9">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="icon small accent" Data="{StaticResource IconWifi}" Width="15" Height="15" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource L.WifiNeighbors}" Classes="h3" FontSize="13.5" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="mini"
                        Height="26"
                        MinHeight="26"
                        Padding="9,0"
                        Content="{DynamicResource L.ScanNeighbors}"
                        Command="{Binding ScanNeighborsCommand}"
                        IsEnabled="{Binding !IsNeighborScanning}" />
              </Grid>
              <TextBlock Text="{Binding NeighborAdvice}"
                         Classes="caption"
                         FontSize="10"
                         LineHeight="15"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding NeighborStatusText}"
                         Classes="micro"
                         FontSize="9.5" />
              <ItemsControl ItemsSource="{Binding NeighborRows}" IsVisible="{Binding HasNeighborRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WifiNeighborRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                        <Ellipse Classes="sevDot"
                                 Classes.warn="{Binding IsWeak}"
                                 VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="0">
                          <TextBlock Text="{Binding Ssid}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Bssid}" Classes="mono" FontSize="8" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="0">
                        <TextBlock Text="{Binding SignalText}" Classes="mono" FontSize="9.5" TextAlignment="Right" />
                        <TextBlock Text="{Binding RateText}" Classes="micro" FontSize="8" TextAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{DynamicResource L.NeighborReadOnlyNote}"
                         Classes="micro"
                         FontSize="8.5"
                         LineHeight="13"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="18,16">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource L.Shortcuts}" Classes="h3" FontSize="13.5" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="9">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="pill" Padding="7,2">
                    <TextBlock Text="Ctrl R" Classes="mono" FontSize="10" />
                  </Border>
                  <TextBlock Text="{DynamicResource L.StartScan}" Classes="caption" FontSize="10.5" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Border Classes="pill" Padding="7,2">
                    <TextBlock Text="Ctrl 1-7" Classes="mono" FontSize="10" />
                  </Border>
                  <TextBlock Text="{DynamicResource L.SwitchPage}" Classes="caption" FontSize="10.5" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                  <Border Classes="pill" Padding="7,2">
                    <TextBlock Text="Ctrl T" Classes="mono" FontSize="10" />
                  </Border>
                  <TextBlock Text="{DynamicResource L.ToggleTheme}" Classes="caption" FontSize="10.5" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Border Classes="pill" Padding="7,2">
                    <TextBlock Text="Esc" Classes="mono" FontSize="10" />
                  </Border>
                  <TextBlock Text="{DynamicResource L.StopScan}" Classes="caption" FontSize="10.5" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="12">
          <Border Classes="card" Padding="18,16">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Classes="icon small accent" Data="{StaticResource IconShield}" Width="15" Height="15" />
                <TextBlock Text="{DynamicResource L.DataPrivacy}" Classes="h3" FontSize="13.5" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding PrivacyText}"
                         Classes="caption"
                         FontSize="10.5"
                         LineHeight="17"
                         TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding HistoryCountText}" Classes="micro" FontSize="10" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding HistoryStatusText}" Classes="micro" FontSize="10" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                <Button Classes="mini" Content="{DynamicResource L.ClearHistory}" Command="{Binding ClearHistoryCommand}" />
                <Button Classes="mini" Content="{DynamicResource L.ExportDiagnostics}" Click="OnExportDiagnosticsClick" />
              </StackPanel>
              <TextBlock Text="{Binding DiagnosticsStatusText}"
                         Classes="micro"
                         FontSize="9.5"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="18,16">
            <StackPanel Spacing="9">
              <TextBlock Text="{DynamicResource L.About}" Classes="eyebrow" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="AirNet" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding VersionText}" Classes="micro" FontSize="10" />
              </Grid>
              <!-- Only inside a package can the two channels disagree on the number. -->
              <TextBlock Text="{Binding PackageText}"
                         Classes="micro"
                         FontSize="9.5"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         IsVisible="{Binding HasPackageNote}" />
              <Border Classes="hairline" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource L.Runtime}" Classes="caption" FontSize="10.5" />
                <TextBlock Grid.Column="1"
                           Text="{Binding RuntimeText}"
                           Classes="micro"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="240"
                           TextAlignment="Right" />
              </Grid>
              <!-- Only platforms that have not been run on real hardware say so. -->
              <TextBlock Text="{Binding PlatformNote}"
                         Classes="micro"
                         FontSize="9.5"
                         Foreground="{DynamicResource WarnBrush}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding HasPlatformNote}" />
              <Border Classes="hairline" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource L.Footprint}" Classes="caption" FontSize="10.5" />
                <TextBlock Grid.Column="1"
                           Text="{Binding FootprintText}"
                           Classes="micro"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="240"
                           TextAlignment="Right" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="18,16">
            <StackPanel Spacing="9">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Classes="icon small accent" Data="{StaticResource IconGlobe}" Width="15" Height="15" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{DynamicResource L.DnsOptimize}" Classes="h3" FontSize="13.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Classes="pill" Padding="8,2">
                  <TextBlock Text="{Binding DnsCurrentText}" Classes="micro" FontSize="9.5" />
                </Border>
              </Grid>
              <TextBlock Text="{Binding DnsHeadlineText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DnsRationaleText}"
                         Classes="caption"
                         FontSize="10"
                         LineHeight="15"
                         TextWrapping="Wrap" />
              <!-- Evidence: the same question asked of each resolver in this run. -->
              <Border Background="{DynamicResource SurfaceAltBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="10,7"
                      IsVisible="{Binding HasDnsEvidence}">
                <ItemsControl ItemsSource="{Binding DnsServerRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,1.5">
                        <TextBlock Text="{Binding Label}" Classes="caption" FontSize="10" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TimeText}"
                                   Classes="mono"
                                   FontSize="10" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <Border Background="{DynamicResource SurfaceAltBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="10,8"
                      IsVisible="{Binding CanApplyDns}">
                <SelectableTextBlock Text="{Binding DnsCommandText}"
                                     Classes="mono"
                                     FontSize="9.5"
                                     TextWrapping="Wrap" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="mini"
                        Content="{DynamicResource L.CopyCommand}"
                        Click="OnCopyDnsCommandClick"
                        IsVisible="{Binding CanApplyDns}" />
                <Button Classes="mini"
                        Content="{DynamicResource L.PreviewNoExec}"
                        Command="{Binding PreviewDnsCommand}"
                        IsVisible="{Binding CanApplyDns}" />
                <Button Classes="mini"
                        Content="{DynamicResource L.ApplyAdmin}"
                        Command="{Binding ApplyDnsCommand}"
                        IsVisible="{Binding CanApplyDns}" />
                <Button Classes="mini"
                        Content="{DynamicResource L.Restore}"
                        Command="{Binding RestoreDnsCommand}"
                        IsVisible="{Binding HasDnsBackup}" />
              </StackPanel>
              <TextBlock Text="{Binding DnsStatusText}" Classes="micro" FontSize="10" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DnsBackupText}"
                         Classes="micro"
                         FontSize="9.5"
                         TextWrapping="Wrap"
                         IsVisible="{Binding HasDnsBackup}" />
              <TextBlock Text="{Binding DnsOperationText}"
                         Classes="micro"
                         FontSize="9.5"
                         TextWrapping="Wrap"
                         IsVisible="{Binding HasDnsOperation}" />
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="18,16">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource L.Project}" Classes="eyebrow" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource L.License}" Classes="caption" FontSize="10.5" />
                <TextBlock Grid.Column="1" Text="MIT" Classes="micro" FontSize="10" />
              </Grid>
              <Border Classes="hairline" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource L.TechStack}" Classes="caption" FontSize="10.5" />
                <TextBlock Grid.Column="1" Text=".NET 10 · Avalonia 11.3" Classes="micro" FontSize="10" />
              </Grid>
              <Border Classes="hairline" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource L.Feedback}" Classes="caption" FontSize="10.5" />
                <TextBlock Grid.Column="1" Text="issue / 邮箱" Classes="micro" FontSize="10" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
