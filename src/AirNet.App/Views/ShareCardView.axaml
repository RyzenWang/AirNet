<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirNet.App.ViewModels"
             xmlns:controls="using:AirNet.App.Controls"
             x:Class="AirNet.App.Views.ShareCardView"
             x:DataType="vm:ShareCardViewModel"
             Width="1080"
             Height="1350">
  <UserControl.Styles>
    <Style Selector="TextBlock.scenarioScore">
      <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
    </Style>
    <Style Selector="TextBlock.scenarioScore.warn">
      <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="TextBlock.scenarioScore.bad">
      <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource AppBackgroundBrush}" Padding="52,52,62,46">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <!-- Brand -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="13">
          <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentBrush}">
            <Path Data="{StaticResource IconPulse}"
                  Width="26"
                  Height="26"
                  Stroke="White"
                  StrokeThickness="2.2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="AirNet" FontSize="24" FontWeight="SemiBold" LetterSpacing="-0.5" />
            <TextBlock Text="NETWORK DIAGNOSTICS" Classes="eyebrow" FontSize="8.5" LetterSpacing="1.6" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="13,7"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding SourceText}" Classes="caption" FontSize="10.5" />
        </Border>
      </Grid>

      <!-- Score panel + metrics -->
      <Grid Grid.Row="1" ColumnDefinitions="390,*" ColumnSpacing="22" Margin="0,32,0,0">
        <Border Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="#F1C8BB"
                BorderThickness="1"
                CornerRadius="20"
                ClipToBounds="True"
                Padding="25,24,25,21">
          <Grid>
            <Ellipse Width="260"
                     Height="260"
                     Fill="#F7D5C9"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-112,-102,0" />
            <StackPanel Spacing="0">
              <TextBlock Text="HEALTH SCORE"
                         Classes="eyebrow"
                         FontSize="9"
                         LetterSpacing="1.6"
                         Foreground="{DynamicResource AccentTextBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,20,0,0" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding ScoreText}"
                           FontSize="128"
                           FontWeight="SemiBold"
                           LetterSpacing="-8"
                           LineHeight="154"
                           VerticalAlignment="Bottom"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="/100"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentTextBrush}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,12" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="9" Margin="1,12,0,0">
                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource GoodBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding GradeLabel}" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Verdict}" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
              <TextBlock Text="{Binding Summary}"
                         FontSize="11.5"
                         LineHeight="17"
                         TextWrapping="Wrap"
                         Foreground="#674E46"
                         MaxWidth="315"
                         Margin="1,10,0,0" />
              <TextBlock Text="{Binding NetworkText}"
                         FontSize="8.5"
                         Foreground="{DynamicResource AccentTextBrush}"
                         Margin="1,15,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="NETWORK REPORT" Classes="eyebrow" FontSize="8.5" />
              <TextBlock Text="这一网，&#10;能打几分？" FontSize="27" FontWeight="SemiBold" LetterSpacing="-0.7" LineHeight="29" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding CapturedText}" Classes="micro" FontSize="9" TextAlignment="Right" VerticalAlignment="Top" />
          </Grid>

          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="9" RowSpacing="9">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="13,12">
              <StackPanel Spacing="2">
                <TextBlock Text="延迟 / LATENCY" Classes="eyebrow" FontSize="8.5" />
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom">
                  <TextBlock Text="{Binding LatencyText}" FontSize="28" FontWeight="SemiBold" LetterSpacing="-0.8" />
                  <TextBlock Text="ms" Classes="unit" FontSize="9.5" Margin="0,0,0,3" />
                </StackPanel>
                <TextBlock Text="平均往返" Classes="micro" FontSize="8.5" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="13,12">
              <StackPanel Spacing="2">
                <TextBlock Text="抖动 / JITTER" Classes="eyebrow" FontSize="8.5" />
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom">
                  <TextBlock Text="{Binding JitterText}" FontSize="28" FontWeight="SemiBold" LetterSpacing="-0.8" />
                  <TextBlock Text="ms" Classes="unit" FontSize="9.5" Margin="0,0,0,3" />
                </StackPanel>
                <TextBlock Text="相邻样本差" Classes="micro" FontSize="8.5" />
              </StackPanel>
            </Border>
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="13,12">
              <StackPanel Spacing="2">
                <TextBlock Text="丢包 / LOSS" Classes="eyebrow" FontSize="8.5" />
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom">
                  <TextBlock Text="{Binding LossText}" FontSize="28" FontWeight="SemiBold" LetterSpacing="-0.8" />
                  <TextBlock Text="%" Classes="unit" FontSize="9.5" Margin="0,0,0,3" />
                </StackPanel>
                <TextBlock Text="ICMP 探测" Classes="micro" FontSize="8.5" />
              </StackPanel>
            </Border>
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="13,12">
              <StackPanel Spacing="2">
                <TextBlock Text="带宽 / BANDWIDTH" Classes="eyebrow" FontSize="8.5" />
                <TextBlock Text="{Binding DownloadText}" FontSize="23" FontWeight="SemiBold" LetterSpacing="-0.5" Margin="0,2,0,0" />
                <TextBlock Text="{Binding UploadFootText}" Classes="micro" FontSize="8.5" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Grid>

      <!-- Scenarios -->
      <StackPanel Grid.Row="2" Spacing="10" Margin="0,24,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="场景体验" Classes="h3" FontSize="14" />
          <TextBlock Grid.Column="1" Text="5 项预测 · 按当前网络计算" Classes="micro" FontSize="9" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Scenarios}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ShareScenarioCard">
              <Border Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="13"
                      Padding="13,12"
                      Margin="0,0,9,9">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Hint}" Classes="micro" FontSize="8.5" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Background="{DynamicResource SurfaceAltBrush}"
                          CornerRadius="9"
                          MinWidth="46"
                          Height="33"
                          Padding="7,0"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScoreText}"
                               Classes="mono scenarioScore"
                               Classes.warn="{Binding IsWarn}"
                               Classes.bad="{Binding IsBad}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Footer -->
      <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,20,0,0" VerticalAlignment="Bottom">
        <StackPanel Spacing="2">
          <TextBlock Text="AirNet · 无驱动 · 无常驻进程" Classes="micro" FontSize="9.5" />
          <TextBlock Text="github.com/RyzenWang/AirNet" Classes="mono" FontSize="9" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="{Binding CapturedText}"
                   Classes="micro"
                   FontSize="9.5"
                   VerticalAlignment="Bottom" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
