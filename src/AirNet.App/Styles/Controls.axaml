<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AirNet.App.Controls">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Type scale. Mirrors AirPDF: one display size, one section size, eyebrow labels for
       metadata, and a dedicated numeric voice for measurements. -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.8" />
    <Setter Property="LineHeight" Value="44" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.3" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.micro">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>

  <!-- Numeric voice: tight tracking so the digits read as one instrument value. -->
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="23" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.7" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.valueBig">
    <Setter Property="FontSize" Value="38" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-1.6" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.unit">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="3,0,0,4" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Path.icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.icon.small">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>
  <Style Selector="Path.icon.muted">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Path.icon.tertiary">
    <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="Path.icon.accent">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.38" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="Button.soft">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="Padding" Value="13,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.soft /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Button.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Opacity" Value="0.82" />
  </Style>
  <Style Selector="Button.soft:pointerover">
    <Setter Property="Opacity" Value="0.92" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="13,8" />
  </Style>
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.mini">
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
  </Style>
  <Style Selector="Button.mini /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
  </Style>
  <Style Selector="Button.mini:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="Button.nav">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.nav TextBlock.navLabel">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.nav.active TextBlock.navLabel">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav Path.navIcon">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="Button.nav.active Path.navIcon">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Segmented control, used for the theme choice -->
  <Style Selector="Button.seg">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.seg /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.seg.active">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.seg.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #18000000" />
  </Style>
  <Style Selector="Button.seg.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <!-- Switch -->
  <Style Selector="ToggleButton.switch">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="21" />
    <Setter Property="MinHeight" Value="21" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Track"
                Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="11">
          <Border Name="Knob"
                  Width="15"
                  Height="15"
                  CornerRadius="8"
                  Margin="2,0,0,0"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource SurfaceBrush}"
                  BoxShadow="0 1 2 0 #33000000" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.switch:checked">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ Border#Track">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ Border#Knob">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="Background" Value="#FBFAF7" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Border.card.floating">
    <Setter Property="BoxShadow" Value="0 12 30 0 #1A000000" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Padding" Value="9,4" />
  </Style>
  <Style Selector="Border.hairline">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- Clickable list rows on the landing page -->
  <Style Selector="Border.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="Margin" Value="0,0,0,1" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <!-- Scanning indicator: a soft pulse while probes are in flight. -->
  <Style Selector="Ellipse.scanDot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Result landing: a single accent wash over the metric card, then gone. -->
  <Style Selector="Border.flashOverlay.blinking">
    <Style.Animations>
      <Animation Duration="0:0:0.48" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.95" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- While a scan runs, the page keeps its last result but visibly steps back. -->
  <Style Selector="Border.pageHost">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.pageHost.scanning">
    <Setter Property="Opacity" Value="0.72" />
  </Style>

  <!-- Severity dots and labels -->
  <Style Selector="Ellipse.tileDot">
    <Setter Property="Width" Value="5" />
    <Setter Property="Height" Value="5" />
    <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.tileDot.warn">
    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="Ellipse.tileDot.bad">
    <Setter Property="Fill" Value="{DynamicResource BadBrush}" />
  </Style>

  <Style Selector="Ellipse.sevDot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
  </Style>
  <Style Selector="Ellipse.sevDot.info">
    <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="Ellipse.sevDot.warn">
    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="Ellipse.sevDot.bad">
    <Setter Property="Fill" Value="{DynamicResource BadBrush}" />
  </Style>

  <Style Selector="TextBlock.score">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.score.warn">
    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="TextBlock.score.bad">
    <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
  </Style>

  <Style Selector="Border.sevBadge">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
  </Style>
  <Style Selector="Border.sevBadge.warn">
    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
  </Style>
  <Style Selector="Border.sevBadge.bad">
    <Setter Property="Background" Value="{DynamicResource BadSoftBrush}" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <!-- Window chrome buttons -->
  <Style Selector="Button.windowControl">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.windowGlyph">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.1" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="Button.windowControl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.windowControl:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
  </Style>
  <Style Selector="Button.windowClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
  </Style>
  <Style Selector="Button.windowClose:pointerover Path.windowGlyph">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <!-- Modern measurement controls -->
  <Style Selector="controls|ScoreRing">
    <Setter Property="Width" Value="128" />
    <Setter Property="Height" Value="128" />
  </Style>
  <Style Selector="controls|Sparkline">
    <Setter Property="Stroke" Value="{DynamicResource GoodBrush}" />
    <Setter Property="Fill" Value="{DynamicResource ChartFillBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector="controls|MeterBar">
    <Setter Property="TrackBrush" Value="{DynamicResource TrackBrush}" />
    <Setter Property="FillBrush" Value="{DynamicResource GoodBrush}" />
  </Style>
  <Style Selector="controls|MeterBar.spike">
    <Setter Property="FillBrush" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="controls|MeterBar.timeout">
    <Setter Property="FillBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
</Styles>
