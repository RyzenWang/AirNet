<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for AirNet.

  Build-Msix.ps1 replaces the {{TOKENS}} before packing; do not hand-edit the copy
  under artifacts/.

  Notes for reviewers:
    * The app ships as a full-trust Win32 process (rescap:runFullTrust). Probing a
      network needs ICMP, raw sockets and the WLAN API, none of which the
      app-container model exposes.
    * The package installs into a read-only WindowsApps folder, so nothing may be
      written next to the executable. AirNet keeps history and settings under the
      per-user application data folder.
    * MSIX cannot elevate, so the Microsoft Store build does not apply DNS changes
      itself: it shows the exact command for the user to run. The portable build
      keeps the one-click path.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity
      Name="{{IDENTITY_NAME}}"
      Publisher="{{PUBLISHER}}"
      Version="{{VERSION}}"
      ProcessorArchitecture="{{ARCH}}" />

  <Properties>
    <DisplayName>AirNet</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A feather-light network diagnostics console: one click says whether the problem is your router, your carrier or the site.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
        Name="Windows.Desktop"
        MinVersion="10.0.19041.0"
        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="zh-cn" />
  </Resources>

  <Applications>
    <Application Id="AirNet"
                 Executable="AirNet.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="AirNet"
          Description="One click says whether the problem is your router, your carrier or the site."
          BackgroundColor="#F1EEE7"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#F1EEE7" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
